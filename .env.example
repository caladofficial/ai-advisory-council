# ==============================================================================
# AI Advisory Council — Environment Configuration (Zero-Paid-Use Safe Defaults)
# ==============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# Database: SQLite works out-of-the-box locally; switch to PostgreSQL+pgvector in Docker/prod
DATABASE_URL=sqlite:///./data/advisory_council.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Strict Zero-Paid-Use Policy
COST_POLICY_MODE=zero_paid
ALLOW_PAID_PROVIDERS=false
ALLOW_CREDIT_CARD_FALLBACK=false
ALLOW_OVER_QUOTA_REQUESTS=false

# Local Inference (Ollama — unlimited, private, $0)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Optional Free Hosted LLM Provider Keys (Keep server-side ONLY!)
GROQ_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
MODELSCOPE_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional Research API Keys (All core connectors work without keys; keys raise rate limits)
OPENALEX_API_KEY=
OPENALEX_EMAIL=
GITHUB_TOKEN=
TAVILY_API_KEY=

# Frontend CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
